{
  "id": "hello-eks-to-gke",
  "source": { "env": "eks",  "namespace": "hello", "cluster": "hello-src",
              "dsn": "postgres://app:${HELLO_PGPASSWORD}@hello-src-rw.hello.svc:5432/app?sslmode=require" },
  "target": { "env": "gke", "kubeconfig": "/work/gke-runner.kubeconfig", "context": "gke", "namespace": "hello", "cluster": "hello-gke",
              "dsn": "postgres://app:${HELLO_PGPASSWORD}@db-gke.hopcharlie-db-network.svc.cluster.local:5432/app?sslmode=require" },
  "gateway": { "mode": "none" },
  "verify": { "schemas": ["public"], "fenceGate": true },
  "thresholds": { "maxLagBytes": 1048576, "catchupTimeout": "10m", "switchoverTimeout": "3m", "maxDowntime": "3m" }
}
