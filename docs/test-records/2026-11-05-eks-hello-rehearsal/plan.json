{
  "id": "hello-src-to-dst",
  "source": { "env": "hello-src", "namespace": "hello", "cluster": "hello-src",
              "dsn": "postgres://app:${HELLO_PGPASSWORD}@hello-src-rw.hello.svc:5432/app?sslmode=require" },
  "target": { "env": "hello-dst", "namespace": "hello", "cluster": "hello-dst",
              "dsn": "postgres://app:${HELLO_PGPASSWORD}@hello-dst-rw.hello.svc:5432/app?sslmode=require", "manifest": "/work/target.yaml" },
  "gateway": { "mode": "none" },
  "verify": { "schemas": ["public"], "fenceGate": true },
  "thresholds": { "maxLagBytes": 1048576, "catchupTimeout": "10m", "switchoverTimeout": "3m", "maxDowntime": "3m" }
}
