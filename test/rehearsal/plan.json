{
  "id": "rehearsal-src-to-dst",
  "source": {
    "env": "src",
    "context": "kind-hop",
    "namespace": "hop",
    "cluster": "pg-src",
    "dsn": "postgres://app:${SRC_PGPASSWORD}@127.0.0.1:55542/app?sslmode=require"
  },
  "target": {
    "env": "dst",
    "context": "kind-hop",
    "namespace": "hop",
    "cluster": "pg-dst",
    "dsn": "postgres://app:${SRC_PGPASSWORD}@127.0.0.1:55543/app?sslmode=require",
    "manifest": "test/rehearsal/target.yaml"
  },
  "gateway": {
    "mode": "none"
  },
  "verify": {
    "schemas": [
      "public"
    ],
    "fenceGate": true
  },
  "thresholds": {
    "maxLagBytes": 1048576,
    "catchupTimeout": "10m",
    "switchoverTimeout": "3m",
    "maxDowntime": "3m"
  }
}
